# ─────────────────────────────────────────────────────────────────────────────
# Bidyut Commerce — environment
# Copy to `.env.local` for development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Absolute origin, no trailing slash. Used for canonical URLs, sitemap,
# OpenGraph images and payment redirect callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never expose to the browser, never prefix with
# NEXT_PUBLIC_. Used by admin service-role queries and payment webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Transactional email (Resend) ─────────────────────────────────────────────
# Leave RESEND_API_KEY empty to disable email; the app logs instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Bidyut <orders@yourdomain.com.bd>"
EMAIL_REPLY_TO=support@yourdomain.com.bd
# Comma-separated list that receives new-order notifications.
ADMIN_NOTIFICATION_EMAILS=

# ── Payments ─────────────────────────────────────────────────────────────────
# Comma-separated provider ids that are live. Anything not listed here is
# hidden at checkout even if credentials exist.
# Valid ids: cod,bkash,nagad,card
PAYMENTS_ENABLED_PROVIDERS=cod

# Shared secret appended to gateway return URLs so we can detect tampering
# before we trust a redirect. Generate with: openssl rand -hex 32
PAYMENT_CALLBACK_SECRET=

# bKash Tokenized Checkout (PGW)
# Sandbox base: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Live base:    https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Nagad Payment Gateway
# Sandbox base: https://sandbox.mynagad.com:10061
# Live base:    https://api.mynagad.com
NAGAD_BASE_URL=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

# Card / aggregator gateway (SSLCOMMERZ used as the reference implementation)
# Sandbox base: https://sandbox.sslcommerz.com
# Live base:    https://securepay.sslcommerz.com
CARD_GATEWAY_BASE_URL=
CARD_GATEWAY_STORE_ID=
CARD_GATEWAY_STORE_PASSWORD=

# ── Storefront contact (rendered in header/footer/support CTA) ───────────────
NEXT_PUBLIC_SUPPORT_PHONE=+8801700000000
NEXT_PUBLIC_SUPPORT_WHATSAPP=8801700000000
NEXT_PUBLIC_SUPPORT_MESSENGER=bidyutbd
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com.bd

# ── Optional ─────────────────────────────────────────────────────────────────
# Set to 1 to expose /admin to any signed-in user in local dev. Never in prod.
# DEV_ALLOW_ANY_ADMIN=0
